# Normalize to LF in the repository regardless of the checkout platform.
# Keeps diffs clean for an eventual upstream pull request.
* text=auto eol=lf

# Windows-only tooling that requires CRLF
*.sln     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Gradle wrapper
gradlew      text eol=lf
gradlew.bat  text eol=crlf

# Binary
*.png     binary
*.jpg     binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.jar     binary
*.dll     binary
*.so      binary
*.keystore binary
*.jks     binary
