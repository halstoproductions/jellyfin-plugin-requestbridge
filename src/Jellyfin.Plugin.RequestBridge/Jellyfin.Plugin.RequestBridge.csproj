<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.RequestBridge</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.RequestBridge</RootNamespace>
    <AssemblyVersion>0.6.1.0</AssemblyVersion>
    <FileVersion>0.6.1.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to 10.11.0, the floor declared as targetAbi in meta.json, not to the
      newest 10.11 patch. Compiling against the floor makes the compatibility
      claim enforced by the compiler rather than merely hoped for: an API added
      after 10.11.0 fails the build here instead of failing at runtime on a user's
      server. See docs/architecture.md section 3.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RequestBridge.Abstractions\RequestBridge.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The state mapper and wire mapping are internal because nothing outside this
      assembly may call them. They are also the pieces most worth testing, so the
      test assembly is granted access rather than the types being made public to
      suit a test.
    -->
    <InternalsVisibleTo Include="Jellyfin.Plugin.RequestBridge.Tests" />
  </ItemGroup>

</Project>
